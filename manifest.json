{
  "manifest_version": 3,
  "name": "Claude Search Parser",
  "version": "1.0.1",
  "description": "Extract and analyze Claude's search behavior for LLM research",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Search Parser"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "config.js"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
